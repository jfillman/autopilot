   "name": "app-provisioner",
   "service_account": null
  },
  "doc": {
   "description": "Provisions any app from an AppSpec, or from a plain-language request turned into one: opens each step of its plan as a pull request for a person to merge, and picks up where an earlier run stopped.",
   "identity": {
    "type": "delegated"
   },
   "kind": "task",
   "name": "app-provisioner",
   "owner": "group:default/team-platform",
   "profile": {
    "airframe": {
     "apps": [
      "*"
     ]
    },
    "compute": "small",
    "limits": {
     "children": 0,
     "githubCalls": 150,
     "modelTokens": 300000,
     "openPrs": 6,
     "toolCalls": 60,
     "ttlMinutes": 30
    },
    "models": [
     "claude-sonnet-5-5"
    ],
    "network": "clearance+model",
    "repos": {
     "allow": [
      "jfillman/*"
     ]
    },
    "tierCeiling": "T1",
    "tools": [
     "airframe.capabilities",
     "airframe.explain",
     "airframe.plan",
     "airframe.apply",
     "airframe.status",
     "airframe.describe",
     "airframe.verify",
     "human.request"
    ]
   },
   "runtime": {
    "framework": "generic",
    "image": "ghcr.io/jfillman/autopilot-agent-runtime@sha256:b1c7b65ba8405726879f27f18982d455cdb4f6c25cdb09eddd642b21e8fbbe6a",
    "instructions": "Bring the app described by the AppSpec in your input up through airframe.apply, and change nothing any other way. If the input is a plain-language request, first use airframe.capabilities, airframe.explain and airframe.plan to turn it into an AppSpec; if anything is ambiguous or unsupported, ask with human.request, never guess or invent a field. 1. airframe.plan the spec (pass baseCicd when you have the app's cicd.yaml). On needsInput or an AF-SPEC error, stop and report the question. 2. airframe.apply with the same spec: ONE pull request per call, or the one already open. Read `state`: `awaiting-merge` means a person must merge `url` (say so and stop; call again only once told it is merged, or ask with human.request); `waiting` carries a `reason`: if the platform is still creating something, report and stop; if a PR was closed, stop and ask with human.request. `agent-steps-merged` means all this tool opens is merged. 3. After a merge, call airframe.apply again with the identical spec for the next step. After an interruption do the same: it resumes from GitHub and never duplicates a PR. 4. `humanSteps` are the Flight half: report them (repo, paths, reason) for a person; never open them another way. Check progress with airframe.status, airframe.describe, and airframe.verify once the environments are up. Report each PR link, what is merged, what waits and on whom, and any failure with its rule id."
   },
   "triggers": [
    {
     "type": "manual"
    }
   ]
  },
  "name": "app-provisioner",
  "runs_in": "cluster",
  "scope": {
   "agent_kind": "task",
   "api_allow": [],
   "deny_paths": [
    ".tekton/**",
    "**/.tekton/**",
    "CODEOWNERS",
    "**/CODEOWNERS",
    ".github/**",
    "**/appproject*.yaml",
    "**/AppProject*.yaml",
    "release.yaml",
    "**/release.yaml",
    "*.release.yaml",
    "**/*.release.yaml"
   ],
   "field_allow": [],
   "field_deny": [
    "/extraManifests",
    "/networkPolicy",
    "/httpRoute",
    "/release",
    "/releaseTracking",
    "/rollout/image"
   ],
   "profile": {
    "airframe": {
     "apps": [
      "*"
     ]
    },
    "compute": "small",
    "limits": {
     "children": 0,
     "githubCalls": 150,
     "modelTokens": 300000,
     "openPrs": 6,
     "toolCalls": 60,
