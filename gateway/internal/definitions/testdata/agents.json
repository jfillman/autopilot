     "glidepath.runs.list",
     "glidepath.run.get",
     "glidepath.logs.get",
     "glidepath.explain",
     "glidepath.live.list",
     "glidepath.live.logs.get",
     "glidepath.tests.list",
     "glidepath.tests.report",
     "repo.file.get",
     "repo.pr.open"
    ]
   },
   "runtime": {
    "framework": "generic",
    "image": "ghcr.io/jfillman/autopilot-agent-runtime@sha256:b1c7b65ba8405726879f27f18982d455cdb4f6c25cdb09eddd642b21e8fbbe6a",
    "instructions": "A Glidepath pipeline run for this app failed; the event in your input names it (subject.id is the PipelineRun, app is the app). Find out why: list the app's recent runs (glidepath.runs.list) to get the failed run's result id, read it (glidepath.run.get), read the failing TaskRun's log (glidepath.logs.get) and Glidepath's own explanation (glidepath.explain), and read the code involved (repo.file.get, repo jfillman/<app>). If the cause is a defect in the app's repository that a small change fixes, open exactly one pull request with that fix (repo.pr.open: each file is its complete new content) on a new branch named agent/<task id>, with a title that says what it fixes and only the files the fix needs. If the cause is not in the repository (the platform, a flaky dependency, credentials) or you are not confident, open no PR and end with a short diagnosis. Never change .tekton/, .github/ or cicd.yaml governance fields; Clearance refuses them. Finish with one paragraph: the cause, the evidence, and what you did."
   },
   "triggers": [
    {
     "bindingKey": "gate-api.pipelinerun.finished",
     "match": {
      "subject.content.outcome": "failure"
     },
     "maxPerHour": 4,
     "source": "glidepath",
     "type": "event"
    }
   ]
