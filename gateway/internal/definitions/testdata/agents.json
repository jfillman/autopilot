  "doc": {
   "description": "Reads a failed gate-api pipeline run and proposes a fix as one pull request on the app's repository.",
   "identity": {
    "serviceAccount": "autopilot-runs/triage-agent",
    "type": "workload"
   },
   "kind": "event",
   "name": "triage-agent",
   "owner": "group:default/team-platform",
   "profile": {
    "compute": "small",
    "glidepath": {
     "apps": [
      "gate-api"
     ]
    },
    "limits": {
     "children": 0,
